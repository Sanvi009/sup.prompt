{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/admin.auth/dashboard/(.*)", "destination": "/admin.auth/dashboard/index.html" },
    { "source": "/admin.auth/users/(.*)", "destination": "/admin.auth/users/index.html" },
    { "source": "/admin.auth/(.*)", "destination": "/admin.auth/index.html" }
  ]
}
